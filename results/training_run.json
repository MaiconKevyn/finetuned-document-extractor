{
  "project": "DocTune",
  "date": "2026-04-20",
  "prompt_version": "v1",
  "base_model": "Qwen/Qwen2.5-1.5B-Instruct",
  "adapter_output": "models/doctune-qwen-1.5b-lora",
  "dataset": {
    "train": "data/train.jsonl",
    "validation": "data/val.jsonl",
    "train_samples": 800,
    "val_samples": 100,
    "test_samples": 100,
    "generation_script": "scripts/generate_dataset.py"
  },
  "quantization": {
    "load_in_4bit": true,
    "bnb_4bit_quant_type": "nf4",
    "bnb_4bit_compute_dtype": "float16",
    "bnb_4bit_use_double_quant": true,
    "model_load_dtype": "float32"
  },
  "lora": {
    "r": 16,
    "lora_alpha": 32,
    "lora_dropout": 0.05,
    "bias": "none",
    "task_type": "CAUSAL_LM",
    "target_modules": [
      "q_proj",
      "k_proj",
      "v_proj",
      "o_proj",
      "gate_proj",
      "up_proj",
      "down_proj"
    ]
  },
  "training": {
    "num_train_epochs": 3,
    "per_device_train_batch_size": 1,
    "gradient_accumulation_steps": 8,
    "effective_batch_size": 8,
    "learning_rate": 0.0001,
    "warmup_steps": 10,
    "optimizer": "paged_adamw_32bit",
    "fp16": false,
    "bf16": false,
    "max_length": 512,
    "eval_strategy": "steps",
    "eval_steps": 100,
    "save_steps": 100
  },
  "hardware": {
    "gpu": "NVIDIA RTX 2070 8GB",
    "cuda": "12.4"
  },
  "benchmark": {
    "eval_samples": 100,
    "dataset": "data/test.jsonl",
    "generated_by": "scripts/eval_suite.py",
    "baseline_shots": [
      0,
      3,
      5,
      10
    ],
    "few_shot_file": "data/train.jsonl",
    "baseline_0shot": {
      "valid_json_rate": 1.0,
      "avg_field_accuracy": 0.7543,
      "business_rule_compliance": 0.74,
      "avg_latency_sec": 3.2252,
      "latency_ms_p95": 3521.4
    },
    "baseline_3shot": {
      "valid_json_rate": 1.0,
      "avg_field_accuracy": 0.9229,
      "business_rule_compliance": 0.95,
      "avg_latency_sec": 2.8327,
      "latency_ms_p95": 3172.54
    },
    "baseline_5shot": {
      "valid_json_rate": 1.0,
      "avg_field_accuracy": 0.9271,
      "business_rule_compliance": 0.96,
      "avg_latency_sec": 4.5536,
      "latency_ms_p95": 5605.82
    },
    "baseline_10shot": {
      "valid_json_rate": 1.0,
      "avg_field_accuracy": 0.9471,
      "business_rule_compliance": 0.95,
      "avg_latency_sec": 5.697,
      "latency_ms_p95": 6239.0
    },
    "fine_tuned": {
      "valid_json_rate": 1.0,
      "avg_field_accuracy": 0.9871,
      "business_rule_compliance": 0.98,
      "avg_latency_sec": 7.8147,
      "latency_ms_p95": 8396.46
    }
  }
}
